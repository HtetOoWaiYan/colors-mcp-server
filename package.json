{
	"name": "@htetoowaiyan/colors-mcp-server",
	"version": "2.1.1",
	"description": "MCP server that gives AI agents exact color math, accessibility checks and ready-made palettes — built for small models. Contrast, OKLCH, gamut, color-blind safety, themes, CSS audit.",
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": "./dist/index.js"
	},
	"bin": {
		"colors-mcp-server": "dist/index.js"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "tsc",
		"prepublishOnly": "npm run build:ui && npm run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "biome lint src",
		"lint:fix": "biome lint --write src",
		"format": "biome format --write src",
		"prepare": "husky",
		"inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
		"build:ui": "node scripts/build-ui.mjs",
		"eval:preflight": "npm --prefix evals run cli -- preflight"
	},
	"keywords": [
		"mcp",
		"mcp-server",
		"colors",
		"color",
		"oklch",
		"wcag",
		"contrast",
		"accessibility",
		"palette",
		"design-tokens",
		"color-blindness",
		"apca",
		"gamut",
		"ui",
		"dataviz"
	],
	"author": "HtetOoWaiYan",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HtetOoWaiYan/colors-mcp-server.git"
	},
	"homepage": "https://github.com/HtetOoWaiYan/colors-mcp-server#readme",
	"bugs": {
		"url": "https://github.com/HtetOoWaiYan/colors-mcp-server/issues"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.4.0",
		"colorjs.io": "0.7.1",
		"pino": "^10.3.1",
		"pino-pretty": "^13.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.15",
		"@modelcontextprotocol/client": "^2.4.0",
		"@modelcontextprotocol/ext-apps": "^2.0.4",
		"@types/node": "^22.13.1",
		"@vitest/coverage-v8": "^3.0.5",
		"husky": "^9.1.7",
		"jsdom": "^31.0.0",
		"lint-staged": "^16.2.7",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3",
		"vite": "^7.3.7",
		"vite-plugin-singlefile": "^2.3.4",
		"vitest": "^3.0.5"
	},
	"lint-staged": {
		"*.{js,ts,json}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
